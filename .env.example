# Copy this file to .env and adjust anything you need to override.
# Nothing here is required, every setting has a working default relative
# to the repo root.

# CORPUS_DIR=/path/to/corpus
# EVAL_DIR=/path/to/eval

# Model weights are large and gitignored, often kept outside the repo
# MODELS_DIR=/path/to/models

# LLAMA_SERVER_URL=http://localhost:8080/v1/chat/completions
# EMBED_MODEL_NAME=BAAI/bge-m3
# TOP_K=12
# FACT_MATCH_THRESHOLD=0.55
# REQUEST_TIMEOUT=900
